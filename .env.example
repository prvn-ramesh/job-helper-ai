# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Sheets OAuth (installed app flow)
# Download from Google Cloud Console → Credentials → OAuth 2.0 Client IDs
GOOGLE_OAUTH_CREDENTIALS_PATH=secrets/client_secret_....json
GOOGLE_OAUTH_TOKEN_PATH=secrets/token.json
# The ID from your Google Sheet URL: /spreadsheets/d/{ID}/edit
GOOGLE_SHEETS_ID=

# Gemini API (free tier: Gemini 3.5 Flash Lite + 3.1 Flash Lite)
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.0-flash-lite
GEMINI_SECONDARY_MODEL=gemini-2.0-flash-lite

# Telegram (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Browser
CHROME_PROFILE_DIR=data/chrome_profile
HEADLESS=false

# Limits
MAX_APPLICATIONS_PER_DAY=25
MIN_SCORE_THRESHOLD=6

# Eligibility/Visa check toggle
ELIGIBILITY_CHECK_ENABLED=true

# Review method: web | telegram | both
REVIEW_METHOD=web

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# SQLite
SQLITE_DB_PATH=data/jobs.db
